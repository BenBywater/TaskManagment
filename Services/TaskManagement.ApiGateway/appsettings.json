{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "TaskManagement_UserService_JWT_SecretKey",
    "Issuer": "TaskManagement.UserService",
    "Audience": "TaskManagement.Client"
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "projects-route": {
        "ClusterId": "projects-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/projects/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "tasks-route": {
        "ClusterId": "tasks-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/tasks/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7285"
          }
        }
      },
      "projects-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7287"
          }
        }
      },
      "tasks-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7289"
          }
        }
      }
    }
  }
}
